import numpy as np
from gnuradio import gr

class blk(gr.sync_block):
    def __init__(self):
        gr.sync_block.__init__(
            self,
            name='e_Diff',
            in_sig=[np.float32],
            out_sig=[np.float32]
        )
        self.last_val = 0.0

    def work(self, input_items, output_items):
        x = input_items[0]
        y0 = output_items[0]
        
        if len(x) > 0:
            # Concatena el último valor procesado previamente para hacer la diferencia continua
            combined = np.concatenate(([self.last_val], x))
            y0[:] = np.diff(combined)
            self.last_val = x[-1]
            
        return len(y0)
